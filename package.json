{
  "name": "whatsmeow-api",
  "version": "0.1.0",
  "description": "RESTful WhatsApp API built with Hono on Bun/Node, powered by whatsmeow-node, with a React dashboard (BHVR-style architecture)",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.5.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/run-server.mjs --watch",
    "dev:client": "vite",
    "start": "node scripts/run-server.mjs",
    "build": "tsc -b && vite build && node scripts/run-server.mjs --build-only",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.167.3",
    "@whatsmeow-node/whatsmeow-node": "^0.7.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "ky": "^1.14.3",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "^6.2.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/router-plugin": "^1.166.12",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
