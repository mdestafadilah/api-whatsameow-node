{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node"],

    // drizzle-orm ships .d.ts files referencing optional peer packages
    // (gel, mysql2) that are not installed; checking them fails our build for
    // reasons that have nothing to do with this project's code.
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `src/vite-env.d.ts` is listed because `tests/` imports client modules
  // (the auth store reads `import.meta.env`), and the env declarations have to
  // be visible to whichever project compiles them.
  "include": [
    "src/api",
    "src/database",
    "src/lib/whatsapp",
    "src/types",
    "src/server.ts",
    "src/env.ts",
    "src/vite-env.d.ts",
    "tests"
  ]
}
