# --- Server ---
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# --- Auth ---
# Sent by clients as `X-API-Key`. Leave empty to disable auth (local development only).
API_KEY=

# --- Database (Drizzle + SQLite) ---
DATABASE_PATH=./data/whatsmeow.db

# --- WhatsApp sessions ---
# Directory holding one whatsmeow store per session id.
SESSION_DIR=./data/sessions

# How long to wait for a single IPC command against the Go binary (ms).
WHATSMEOW_COMMAND_TIMEOUT=30000

# Seconds a generated pairing code stays valid. WhatsApp accepts ~60s windows.
PAIR_CODE_TTL=60

# --- Redis (optional) ---
# Leave REDIS_URL empty to run without Redis: sends go straight through and
# caching is skipped. The API never depends on Redis being up — if it cannot be
# reached, the affected features degrade instead of failing.
REDIS_URL=redis://127.0.0.1:6379
# Key prefix, so one Redis can host several environments.
REDIS_PREFIX=whatsmeow
# TTL for cached reads such as chat lists and health snapshots (seconds).
REDIS_CACHE_TTL=30
# How many queued messages a single drain pass may send before yielding.
REDIS_QUEUE_BATCH=20

# --- Client dev server ---
# Where Vite proxies /api during development.
API_PROXY_TARGET=http://localhost:3000

# --- Dashboard sign-in (build-time, client bundle) ---
# Read by the React app via `import.meta.env`, so they must be present when the
# client is built. Leave VITE_DASHBOARD_PASSWORD empty and the login screen falls
# back to admin/admin and shows a warning banner.
#
# NOTE: this is a UI gate only — the values are compiled into the JavaScript
# bundle. The REST API stays protected by API_KEY above, not by these.
VITE_DASHBOARD_USERNAME=admin
VITE_DASHBOARD_PASSWORD=
